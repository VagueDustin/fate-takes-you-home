{
  "$schema": "./theme.schema.json",
  "id": "fate-utility",
  "name": "FATE Utility",
  "author": "VagueDustin Enterprises",
  "version": "1.0.0",
  "description": "The Fated Updates treatment. Gold behaves as flat material, one animation at a time, nothing decorative.",
  "basedOn": "fate",
  "tier": "utility",

  "motion": {
    "flyoutOpenMs": 140,
    "flyoutCloseMs": 100,
    "flyoutTravel": 8,
    "flyoutScaleFrom": 1.0,
    "flyoutEasing": "cubic-bezier(0.2, 0.7, 0.3, 1)"
  },

  "buttons": {
    "style": "foil",
    "hoverLift": 0,
    "pressScale": 1.0,
    "activeGlow": false
  },

  "backdrop": {
    "shadowBlur": 20,
    "shadowOpacity": 0.6
  }
}
