<UserControl
  x:Class="FateTakesYouHome.Views.Pages.ThemesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:FateTakesYouHome.Controls"
  xmlns:conv="clr-namespace:FateTakesYouHome.Converters"
  xmlns:loading="clr-namespace:FateTakesYouHome.Theming.Loading;assembly=FateTakesYouHome.Theming"
  xmlns:vm="clr-namespace:FateTakesYouHome.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:ThemesViewModel}">

  <UserControl.Resources>
    <conv:NullOrEmptyToVisibilityConverter x:Key="TextToVisibility" />
    <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
    <conv:CountToVisibilityConverter x:Key="AnyToVisibility" />
    <conv:ThemeSwatchConverter x:Key="Swatch" />

    <!-- A skeleton line inside a preview card: a rounded bar in one of the theme's own colours. -->
    <Style x:Key="PreviewBar" TargetType="Border">
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
  </UserControl.Resources>

  <Grid>

    <!-- ============================================================ browsing -->

    <ContentControl x:Name="ThemeList">
      <ContentControl.Style>
        <Style TargetType="ContentControl" BasedOn="{StaticResource Fate.Panel}">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsEditing}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ContentControl.Style>

      <ScrollViewer Style="{StaticResource Fate.ScrollViewer}">
        <StackPanel Margin="26,22,36,26">

          <c:TrackedTextBlock Style="{StaticResource Fate.Display.SectionLabel}" Text="Appearance" />

          <!-- ==================================================== theme cards -->

          <TextBlock Margin="0,14,0,0" Style="{StaticResource Fate.Text.Subtitle}" Text="Theme" />
          <TextBlock
            Margin="0,4,0,0"
            Style="{StaticResource Fate.Text.Faint}"
            TextWrapping="Wrap"
            Text="Pick one and the whole interface repaints, tray panel included. The gold check is the one you are looking at." />

          <ListBox
            Margin="0,12,0,0"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding Available}"
            SelectedItem="{Binding Selected}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            KeyboardNavigation.DirectionalNavigation="Cycle">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border
                        x:Name="Face"
                        Width="176"
                        Background="{Binding Converter={StaticResource Swatch}, ConverterParameter=raised}"
                        BorderBrush="{DynamicResource Fate.Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Fate.Radius.Md}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Face" Property="BorderBrush"
                                  Value="{DynamicResource Fate.Brush.BorderDefault}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Face" Property="BorderBrush"
                                  Value="{DynamicResource Fate.Brush.AccentDefault}" />
                          <Setter TargetName="Face" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter TargetName="Face" Property="BorderBrush"
                                  Value="{DynamicResource Fate.Brush.AccentHover}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type loading:ThemeEntry}">
                <StackPanel>
                  <!-- The theme sketching itself: its surface, its text, its accent. -->
                  <Border
                    Margin="8,8,8,0"
                    Height="64"
                    Background="{Binding Converter={StaticResource Swatch}, ConverterParameter=surface}"
                    BorderBrush="{Binding Converter={StaticResource Swatch}, ConverterParameter=border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Fate.Radius.Sm}">
                    <Grid Margin="10,9">
                      <StackPanel>
                        <Border Style="{StaticResource PreviewBar}" Width="104"
                                Background="{Binding Converter={StaticResource Swatch}, ConverterParameter=text}"
                                Opacity="0.85" />
                        <Border Style="{StaticResource PreviewBar}" Width="76" Margin="0,7,0,0"
                                Background="{Binding Converter={StaticResource Swatch}, ConverterParameter=muted}"
                                Opacity="0.7" />
                        <Border Style="{StaticResource PreviewBar}" Width="56" Margin="0,7,0,0"
                                Background="{Binding Converter={StaticResource Swatch}, ConverterParameter=accent}" />
                      </StackPanel>

                      <!-- The applied check, in the card's own accent. -->
                      <Border
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        CornerRadius="9"
                        Background="{Binding Converter={StaticResource Swatch}, ConverterParameter=accent}"
                        Visibility="{Binding IsSelected,
                                     RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                     Converter={StaticResource BoolToVisibility}}">
                        <Path
                          Data="{StaticResource Fate.Icon.Check}"
                          Stroke="{Binding Converter={StaticResource Swatch}, ConverterParameter=surface}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform"
                          Width="9"
                          Height="9" />
                      </Border>
                    </Grid>
                  </Border>

                  <StackPanel Margin="10,7,10,9">
                    <TextBlock
                      FontFamily="{DynamicResource Fate.Font.Body}"
                      FontSize="{DynamicResource Fate.Size.Body}"
                      FontWeight="SemiBold"
                      Foreground="{Binding Converter={StaticResource Swatch}, ConverterParameter=text}"
                      TextTrimming="CharacterEllipsis"
                      Text="{Binding DisplayName}" />
                    <TextBlock
                      Margin="0,2,0,0"
                      FontFamily="{DynamicResource Fate.Font.Body}"
                      FontSize="{DynamicResource Fate.Size.Caption}"
                      Foreground="{Binding Converter={StaticResource Swatch}, ConverterParameter=muted}"
                      TextTrimming="CharacterEllipsis"
                      Text="{Binding Document.Description}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- ==================================================== theme actions -->

          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="New" Command="{Binding NewThemeCommand}" />
            <Button Margin="8,0,0,0" Content="Edit" Command="{Binding EditCommand}"
                    IsEnabled="{Binding CanEditSelected}" />
            <Button Margin="8,0,0,0" Content="Duplicate" Command="{Binding DuplicateCommand}"
                    IsEnabled="{Binding CanEditSelected}" />
            <Button Margin="8,0,0,0" Content="Delete" Command="{Binding DeleteCommand}"
                    IsEnabled="{Binding CanDeleteSelected}" />
            <Button Margin="8,0,0,0" Content="Import" Command="{Binding ImportCommand}" />
            <Button Margin="8,0,0,0" Content="Export" Command="{Binding ExportCommand}"
                    IsEnabled="{Binding CanEditSelected}" />
            <Button Margin="8,0,0,0" Content="Open themes folder" Command="{Binding OpenThemesFolderCommand}" />
          </StackPanel>

          <TextBlock
            Margin="0,10,0,0"
            Style="{StaticResource Fate.Text.Faint}"
            TextWrapping="Wrap"
            Text="{Binding StatusMessage}"
            Visibility="{Binding StatusMessage, Converter={StaticResource TextToVisibility}}" />

          <TextBlock
            Margin="0,10,0,0"
            Style="{StaticResource Fate.Text.Faint}"
            TextWrapping="Wrap"
            Text="Themes are patches: a file only declares what it changes and inherits the rest. Drop a .json file in the themes folder and it appears here within a second — edit it while the app runs and the interface repaints as you save." />

          <!-- ==================================================== fonts -->

          <Border Style="{StaticResource Fate.Divider}" Margin="0,22" />

          <TextBlock Style="{StaticResource Fate.Text.Subtitle}" Text="Fonts" />
          <TextBlock
            Margin="0,4,0,0"
            Style="{StaticResource Fate.Text.Faint}"
            TextWrapping="Wrap"
            Text="Your choice wins over every theme. Leave a slot on “Theme default” to let the theme decide." />

          <Grid Margin="0,14,0,0" MaxWidth="760" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource Fate.Text.Body}" FontWeight="Medium" Text="Display" />
              <TextBlock Margin="0,2,0,5" Style="{StaticResource Fate.Text.Faint}" Text="Titles and the wordmark." />
              <ComboBox
                Style="{StaticResource Fate.ComboBox}"
                ItemsSource="{Binding FontChoices}"
                SelectedItem="{Binding DisplayFontChoice}"
                AutomationProperties.Name="Display font" />
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Fate.Text.Body}" FontWeight="Medium" Text="Body" />
              <TextBlock Margin="0,2,0,5" Style="{StaticResource Fate.Text.Faint}" Text="Everything you read." />
              <ComboBox
                Style="{StaticResource Fate.ComboBox}"
                ItemsSource="{Binding FontChoices}"
                SelectedItem="{Binding BodyFontChoice}"
                AutomationProperties.Name="Body font" />
            </StackPanel>

            <StackPanel Grid.Column="4">
              <TextBlock Style="{StaticResource Fate.Text.Body}" FontWeight="Medium" Text="Mono" />
              <TextBlock Margin="0,2,0,5" Style="{StaticResource Fate.Text.Faint}" Text="Entity ids and file paths." />
              <ComboBox
                Style="{StaticResource Fate.ComboBox}"
                ItemsSource="{Binding FontChoices}"
                SelectedItem="{Binding MonoFontChoice}"
                AutomationProperties.Name="Mono font" />
            </StackPanel>
          </Grid>

          <!-- ==================================================== shortcuts -->

          <Border Style="{StaticResource Fate.Divider}" Margin="0,22" />

          <TextBlock Style="{StaticResource Fate.Text.Subtitle}" Text="Shortcuts" />
          <TextBlock
            Margin="0,4,0,0"
            Style="{StaticResource Fate.Text.Faint}"
            TextWrapping="Wrap"
            Text="System-wide keys — they work from any application. Click a box and press the combination; Escape clears it." />

          <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Shortcuts}" MaxWidth="760" HorizontalAlignment="Left">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ShortcutRow}">
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Fate.Text.Body}" FontWeight="Medium" Text="{Binding Label}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Fate.Text.Faint}"
                               TextWrapping="Wrap" Text="{Binding Description}" />
                    <TextBlock
                      Margin="0,3,0,0"
                      Style="{StaticResource Fate.Text.Caption}"
                      Foreground="{DynamicResource Fate.Brush.StatusWarning}"
                      TextWrapping="Wrap"
                      Text="{Binding Failure}"
                      Visibility="{Binding Failure, Converter={StaticResource TextToVisibility}}" />
                  </StackPanel>

                  <c:ShortcutBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource Fate.TextBox}"
                    Padding="9,7"
                    GestureText="{Binding Gesture}"
                    AutomationProperties.Name="{Binding Label}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </ContentControl>

    <!-- ============================================================ editing -->

    <ContentControl>
      <ContentControl.Style>
        <Style TargetType="ContentControl" BasedOn="{StaticResource Fate.Panel}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsEditing}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ContentControl.Style>

      <Grid>
        <!-- Editing. -->
        <ScrollViewer>
          <ScrollViewer.Style>
            <Style TargetType="ScrollViewer" BasedOn="{StaticResource Fate.ScrollViewer}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ScrollViewer.Style>

          <StackPanel Margin="26,24,36,26">

            <!-- Identity -->
            <Grid>
              <StackPanel>
                <c:TrackedTextBlock Style="{StaticResource Fate.Display.SectionLabel}" Text="Editing" />
                <TextBlock
                  Margin="0,7,0,0"
                  Style="{StaticResource Fate.Text.Faint}"
                  Text="Unsaved changes"
                  Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Discard" Command="{Binding CancelEditCommand}" />
                <Button Margin="8,0,0,0" Content="Save" Command="{Binding SaveCommand}" />
              </StackPanel>
            </Grid>

            <Border Style="{StaticResource Fate.Card}" Padding="18" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Fate.Text.Body}" FontWeight="Medium" Text="Name" />
                <TextBox
                  Margin="0,5,0,0"
                  Style="{StaticResource Fate.TextBox}"
                  Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,14,0,0" Style="{StaticResource Fate.Text.Body}"
                           FontWeight="Medium" Text="Description" />
                <TextBox
                  Margin="0,5,0,0"
                  Style="{StaticResource Fate.TextBox}"
                  TextWrapping="Wrap"
                  AcceptsReturn="True"
                  MinHeight="54"
                  Text="{Binding DraftDescription, UpdateSourceTrigger=PropertyChanged}" />

                <UniformGrid Columns="2" Margin="0,14,0,0">
                  <StackPanel Margin="0,0,7,0">
                    <TextBlock Style="{StaticResource Fate.Text.Body}" FontWeight="Medium" Text="Ornament tier" />
                    <ComboBox
                      Margin="0,5,0,0"
                      Style="{StaticResource Fate.ComboBox}"
                      ItemsSource="{Binding Tiers}"
                      SelectedItem="{Binding DraftTier}" />
                  </StackPanel>
                  <StackPanel Margin="7,0,0,0">
                    <TextBlock Style="{StaticResource Fate.Text.Body}" FontWeight="Medium" Text="Appearance" />
                    <ComboBox
                      Margin="0,5,0,0"
                      Style="{StaticResource Fate.ComboBox}"
                      ItemsSource="{Binding Appearances}"
                      SelectedItem="{Binding DraftAppearance}" />
                  </StackPanel>
                </UniformGrid>

                <TextBlock
                  Margin="0,8,0,0"
                  Style="{StaticResource Fate.Text.Faint}"
                  TextWrapping="Wrap"
                  Text="The tier sets the defaults for every ornament switch. Ceremonial is ornate, utility is restrained, charted sits between them." />
              </StackPanel>
            </Border>

            <!-- Colours -->
            <Border Style="{StaticResource Fate.Card}" Padding="18" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Fate.Text.Subtitle}" Text="Colours" />
                <TextBlock
                  Margin="0,5,0,0"
                  Style="{StaticResource Fate.Text.Faint}"
                  TextWrapping="Wrap"
                  Text="Semantic roles, not raw values. Accepts #RGB, #RRGGBB, #RRGGBBAA in CSS order, rgb(), rgba() and colour names." />

                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Colors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ThemeColorSlot}">
                      <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="150" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                          Grid.Column="0"
                          Width="26"
                          Height="26"
                          Margin="0,0,11,0"
                          VerticalAlignment="Center"
                          Background="{Binding Swatch}"
                          BorderBrush="{DynamicResource Fate.Brush.BorderDefault}"
                          BorderThickness="1"
                          CornerRadius="{DynamicResource Fate.Radius.Sm}" />

                        <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Style="{StaticResource Fate.Text.Caption}"
                          Text="{Binding Label}" />

                        <StackPanel Grid.Column="2">
                          <TextBox
                            Style="{StaticResource Fate.TextBox}"
                            Padding="8,6"
                            FontFamily="{DynamicResource Fate.Font.Mono}"
                            Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{Binding Label}" />
                          <TextBlock
                            Margin="2,3,0,0"
                            Style="{StaticResource Fate.Text.Caption}"
                            Foreground="{DynamicResource Fate.Brush.StatusDanger}"
                            TextWrapping="Wrap"
                            Text="{Binding Error}"
                            Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Buttons and shape -->
            <Border Style="{StaticResource Fate.Card}" Padding="18" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Fate.Text.Subtitle}" Text="Controls and shape" />

                <TextBlock Margin="0,14,0,0" Style="{StaticResource Fate.Text.Body}"
                           FontWeight="Medium" Text="Button style" />
                <ComboBox
                  Margin="0,5,0,0"
                  Style="{StaticResource Fate.ComboBox}"
                  ItemsSource="{Binding ButtonStyles}"
                  SelectedItem="{Binding DraftButtonStyle}" />
                <TextBlock
                  Margin="0,5,0,0"
                  Style="{StaticResource Fate.Text.Faint}"
                  TextWrapping="Wrap"
                  Text="Engraved is a recessed face with a lit top edge. Foil is a solid accent slab. Glow keeps the surface dark and adds a halo. Ghost and outline are the quiet options." />

                <TextBlock Margin="0,16,0,0" Style="{StaticResource Fate.Text.Body}"
                           FontWeight="Medium" Text="Corner radius" />
                <Grid Margin="0,5,0,0">
                  <Slider Style="{StaticResource Fate.Slider}" Minimum="0" Maximum="24"
                          Value="{Binding DraftRadiusMd}" Margin="0,0,44,0" />
                  <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                             Style="{StaticResource Fate.Text.Mono}" Text="{Binding DraftRadiusMd, StringFormat={}{0:0}}" />
                </Grid>

                <TextBlock Margin="0,14,0,0" Style="{StaticResource Fate.Text.Body}"
                           FontWeight="Medium" Text="Tray panel width" />
                <Grid Margin="0,5,0,0">
                  <Slider Style="{StaticResource Fate.Slider}" Minimum="240" Maximum="720"
                          Value="{Binding DraftFlyoutWidth}" Margin="0,0,44,0" />
                  <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                             Style="{StaticResource Fate.Text.Mono}" Text="{Binding DraftFlyoutWidth, StringFormat={}{0:0}}" />
                </Grid>

                <TextBlock Margin="0,14,0,0" Style="{StaticResource Fate.Text.Body}"
                           FontWeight="Medium" Text="Row height" />
                <Grid Margin="0,5,0,0">
                  <Slider Style="{StaticResource Fate.Slider}" Minimum="32" Maximum="120"
                          Value="{Binding DraftTileHeight}" Margin="0,0,44,0" />
                  <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                             Style="{StaticResource Fate.Text.Mono}" Text="{Binding DraftTileHeight, StringFormat={}{0:0}}" />
                </Grid>

                <TextBlock Margin="0,16,0,0" Style="{StaticResource Fate.Text.Body}"
                           FontWeight="Medium" Text="Window backdrop" />
                <ComboBox
                  Margin="0,5,0,0"
                  Style="{StaticResource Fate.ComboBox}"
                  ItemsSource="{Binding BackdropModes}"
                  SelectedItem="{Binding DraftBackdrop}" />
                <TextBlock
                  Margin="0,5,0,0"
                  Style="{StaticResource Fate.Text.Faint}"
                  TextWrapping="Wrap"
                  Text="Composited gives the smoothest animation on every Windows build. Acrylic adds a blur where Windows allows it and falls back quietly where it does not." />
              </StackPanel>
            </Border>

            <!-- Motion -->
            <Border Style="{StaticResource Fate.Card}" Padding="18" Margin="0,14,0,0">
              <StackPanel>
                <Grid>
                  <TextBlock Style="{StaticResource Fate.Text.Subtitle}" Text="Motion" />
                  <ToggleButton
                    HorizontalAlignment="Right"
                    Style="{StaticResource Fate.Switch}"
                    IsChecked="{Binding DraftMotionEnabled}"
                    AutomationProperties.Name="Motion enabled" />
                </Grid>

                <TextBlock Margin="0,16,0,0" Style="{StaticResource Fate.Text.Body}"
                           FontWeight="Medium" Text="Overall speed" />
                <Grid Margin="0,5,0,0">
                  <Slider Style="{StaticResource Fate.Slider}" Minimum="0.25" Maximum="2.5"
                          Value="{Binding DraftSpeedScale}" Margin="0,0,44,0" />
                  <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                             Style="{StaticResource Fate.Text.Mono}" Text="{Binding DraftSpeedScale, StringFormat={}{0:0.00}×}" />
                </Grid>

                <TextBlock Margin="0,14,0,0" Style="{StaticResource Fate.Text.Body}"
                           FontWeight="Medium" Text="Panel entrance" />
                <Grid Margin="0,5,0,0">
                  <Slider Style="{StaticResource Fate.Slider}" Minimum="60" Maximum="600"
                          Value="{Binding DraftFlyoutOpenMs}" Margin="0,0,52,0" />
                  <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                             Style="{StaticResource Fate.Text.Mono}" Text="{Binding DraftFlyoutOpenMs, StringFormat={}{0:0} ms}" />
                </Grid>

                <TextBlock Margin="0,14,0,0" Style="{StaticResource Fate.Text.Body}"
                           FontWeight="Medium" Text="Travel distance" />
                <Grid Margin="0,5,0,0">
                  <Slider Style="{StaticResource Fate.Slider}" Minimum="0" Maximum="60"
                          Value="{Binding DraftFlyoutTravel}" Margin="0,0,52,0" />
                  <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                             Style="{StaticResource Fate.Text.Mono}" Text="{Binding DraftFlyoutTravel, StringFormat={}{0:0} px}" />
                </Grid>

                <TextBlock Margin="0,14,0,0" Style="{StaticResource Fate.Text.Body}"
                           FontWeight="Medium" Text="Grows from" />
                <Grid Margin="0,5,0,0">
                  <Slider Style="{StaticResource Fate.Slider}" Minimum="0.7" Maximum="1.0"
                          Value="{Binding DraftFlyoutScaleFrom}" Margin="0,0,52,0" />
                  <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                             Style="{StaticResource Fate.Text.Mono}" Text="{Binding DraftFlyoutScaleFrom, StringFormat={}{0:0.00}×}" />
                </Grid>

                <TextBlock Margin="0,16,0,0" Style="{StaticResource Fate.Text.Body}"
                           FontWeight="Medium" Text="Easing curve" />
                <ComboBox
                  Margin="0,5,0,0"
                  Style="{StaticResource Fate.ComboBox}"
                  IsEditable="True"
                  ItemsSource="{Binding EasingPresets}"
                  Text="{Binding DraftFlyoutEasing, UpdateSourceTrigger=LostFocus}" />
                <TextBlock
                  Margin="0,5,0,0"
                  Style="{StaticResource Fate.Text.Faint}"
                  TextWrapping="Wrap"
                  Text="A preset name, or a literal cubic-bezier(x1, y1, x2, y2). fate-spring overshoots slightly so the panel settles rather than stopping dead." />
              </StackPanel>
            </Border>

            <!-- Ornament -->
            <Border Style="{StaticResource Fate.Card}" Padding="18" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Fate.Text.Subtitle}" Text="Ornament" />
                <TextBlock
                  Margin="0,5,0,0"
                  Style="{StaticResource Fate.Text.Faint}"
                  TextWrapping="Wrap"
                  Text="Each switch defaults to whatever the tier prescribes. Change one only to make a deliberate exception." />

                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Ornaments}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ThemeSwitchSlot}">
                      <Grid Margin="0,0,0,12">
                        <StackPanel Margin="0,0,60,0">
                          <TextBlock Style="{StaticResource Fate.Text.Body}" Text="{Binding Label}" />
                          <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource Fate.Text.Faint}"
                            TextWrapping="Wrap"
                            Text="{Binding Description}" />
                        </StackPanel>
                        <ToggleButton
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Style="{StaticResource Fate.Switch}"
                          IsChecked="{Binding Value}"
                          AutomationProperties.Name="{Binding Label}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Diagnostics -->
            <Border
              Style="{StaticResource Fate.Card}"
              Padding="18"
              Margin="0,14,0,0"
              Visibility="{Binding Diagnostics.Count, Converter={StaticResource AnyToVisibility}}">
              <StackPanel>
                <TextBlock Style="{StaticResource Fate.Text.Subtitle}" Text="What the checker says" />
                <TextBlock
                  Margin="0,5,0,12"
                  Style="{StaticResource Fate.Text.Faint}"
                  TextWrapping="Wrap"
                  Text="Contrast is checked against WCAG AA, and the house rule that the accent means “interactive” is enforced here too." />

                <ItemsControl ItemsSource="{Binding Diagnostics}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                          Grid.Column="0"
                          Width="6"
                          Margin="0,2,10,2"
                          CornerRadius="3"
                          Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />

                        <StackPanel Grid.Column="1">
                          <TextBlock Style="{StaticResource Fate.Text.Mono}" Text="{Binding Field}" />
                          <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource Fate.Text.Caption}"
                            TextWrapping="Wrap"
                            Text="{Binding Message}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </ContentControl>
  </Grid>
</UserControl>
