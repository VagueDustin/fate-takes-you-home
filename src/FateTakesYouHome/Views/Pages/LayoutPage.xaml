<UserControl
  x:Class="FateTakesYouHome.Views.Pages.LayoutPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:FateTakesYouHome.Controls"
  xmlns:conv="clr-namespace:FateTakesYouHome.Converters"
  xmlns:vm="clr-namespace:FateTakesYouHome.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:LayoutEditorViewModel}">

  <UserControl.Resources>
    <conv:NullOrEmptyToVisibilityConverter x:Key="TextToVisibility" />

    <!-- The stand-in card an arrangeable widget shows in the editor. Deliberately not the live
         widget: dragging a card must never fire the action it stands for. -->
    <DataTemplate DataType="{x:Type vm:EditorWidget}">
      <Border
        x:Name="Chrome"
        Background="{DynamicResource Fate.Brush.SurfaceOverlay}"
        BorderBrush="{DynamicResource Fate.Brush.BorderDefault}"
        BorderThickness="1"
        CornerRadius="{DynamicResource Fate.Radius.Md}"
        Cursor="SizeAll"
        MouseLeftButtonDown="OnWidgetGrabbed">
        <Grid>
          <StackPanel Margin="12,8,26,8" VerticalAlignment="Center">
            <TextBlock
              Style="{StaticResource Fate.Text.Body}"
              FontWeight="Medium"
              TextTrimming="CharacterEllipsis"
              Text="{Binding Title}" />
            <TextBlock
              Margin="0,2,0,0"
              Style="{StaticResource Fate.Text.Faint}"
              TextTrimming="CharacterEllipsis"
              Text="{Binding Subtitle}" />
          </StackPanel>

          <!-- Remove. -->
          <Button
            Width="24"
            Height="24"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,4,4,0"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="{Binding}"
            ToolTip="Remove"
            AutomationProperties.Name="Remove widget">
            <Path Style="{StaticResource Fate.UiIcon}" Width="10" Height="10"
                  Data="{StaticResource Fate.Icon.Close}" />
          </Button>

          <!-- Resize grip. -->
          <Path
            x:Name="Grip"
            Data="M 8 0 L 0 8 M 8 4 L 4 8"
            Stroke="{DynamicResource Fate.Brush.TextFaint}"
            StrokeThickness="1.4"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round"
            Width="9"
            Height="9"
            Margin="0,0,5,5"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Stretch="Uniform"
            Cursor="SizeNWSE"
            MouseLeftButtonDown="OnGripGrabbed" />
        </Grid>
      </Border>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsInvalid}" Value="True">
          <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Fate.Brush.StatusDanger}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <ContentControl Style="{StaticResource Fate.Panel}">
    <Grid>
      <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== heading -->

        <Grid Grid.Row="0">
          <StackPanel>
            <c:TrackedTextBlock Style="{StaticResource Fate.Display.SectionLabel}" Text="Layout" />
            <TextBlock
              Margin="0,8,0,0"
              Style="{StaticResource Fate.Text.Muted}"
              TextWrapping="Wrap"
              Text="Arrange the home screen and the tray panel like a phone: drag to move, pull the corner to resize." />
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button
              Style="{StaticResource Fate.Button.Primary}"
              Content="Save layout"
              Command="{Binding SaveCommand}" />
            <Button Margin="8,0,0,0" Content="Discard" Command="{Binding DiscardCommand}" />
            <Button Margin="8,0,0,0" Content="Back to standard" Command="{Binding ResetToStandardCommand}"
                    ToolTip="Forget the custom layout and return to the built-in view." />
          </StackPanel>
        </Grid>

        <!-- ======================================================== surface + palette -->

        <Grid Grid.Row="1" Margin="0,16,0,0">
          <StackPanel Orientation="Horizontal">
            <!-- Which surface is being arranged. -->
            <Border
              Background="{DynamicResource Fate.Brush.SurfaceOverlay}"
              BorderBrush="{DynamicResource Fate.Brush.BorderSubtle}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Fate.Radius.Pill}"
              Padding="4">
              <StackPanel Orientation="Horizontal">
                <RadioButton
                  x:Name="HomeSurface"
                  Style="{StaticResource Fate.SegmentButton}"
                  GroupName="LayoutSurface"
                  Content="Home screen"
                  IsChecked="True"
                  AutomationProperties.Name="Edit the home screen layout" />
                <RadioButton
                  Style="{StaticResource Fate.SegmentButton}"
                  GroupName="LayoutSurface"
                  Content="Tray panel"
                  IsChecked="{Binding EditingFlyout}"
                  AutomationProperties.Name="Edit the tray panel layout" />
              </StackPanel>
            </Border>

            <TextBlock
              Margin="14,0,0,0"
              VerticalAlignment="Center"
              Style="{StaticResource Fate.Text.Faint}"
              Text="{Binding StatusMessage}"
              Visibility="{Binding StatusMessage, Converter={StaticResource TextToVisibility}}" />
          </StackPanel>

          <!-- What can be added. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="+ Tile" Command="{Binding BeginAddTileCommand}"
                    ToolTip="An entity with its full controls." />
            <Button Margin="6,0,0,0" Content="+ Graph" Command="{Binding BeginAddSparklineCommand}"
                    ToolTip="History of a numeric sensor over time." />
            <Button Margin="6,0,0,0" Content="+ Button" Command="{Binding BeginAddQuickActionCommand}"
                    ToolTip="One big button that runs one entity." />
            <Button Margin="6,0,0,0" Content="+ All lights off" Command="{Binding AddAllLightsOffCommand}" />
            <Button Margin="6,0,0,0" Content="+ Rooms" Command="{Binding AddRoomsCommand}"
                    IsEnabled="{Binding AllowsSummaryWidgets}" />
            <Button Margin="6,0,0,0" Content="+ Activity" Command="{Binding AddActivityCommand}"
                    IsEnabled="{Binding AllowsSummaryWidgets}" />
          </StackPanel>
        </Grid>

        <!-- ======================================================== canvas -->

        <Border
          Grid.Row="2"
          Margin="0,14,0,0"
          Background="{DynamicResource Fate.Brush.SurfaceSunken}"
          BorderBrush="{DynamicResource Fate.Brush.BorderSubtle}"
          BorderThickness="1"
          CornerRadius="{DynamicResource Fate.Radius.Md}"
          Padding="12">
          <Grid>
            <ScrollViewer Style="{StaticResource Fate.ScrollViewer}">
              <StackPanel>
                <TextBlock
                  Style="{StaticResource Fate.Text.Faint}"
                  TextWrapping="Wrap"
                  Margin="0,0,0,10"
                  Text="{Binding SurfaceExplainer}" />

                <ItemsControl
                  x:Name="EditorHost"
                  ItemsSource="{Binding Items}"
                  ItemContainerStyle="{StaticResource Fate.WidgetContainer}"
                  MouseMove="OnCanvasMouseMove"
                  MouseLeftButtonUp="OnCanvasMouseUp">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <c:WidgetCanvas
                        Columns="{Binding Columns}"
                        RowHeight="{Binding RowHeight}"
                        Gap="10"
                        Background="Transparent" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Room to drop things below the last row. -->
                <Border Height="120" Background="Transparent" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- ======================================================== entity picker -->

      <Grid
        Background="{DynamicResource Fate.Brush.Scrim}"
        Visibility="{Binding IsPicking, Converter={StaticResource BoolToVisibility}}">
        <Border
          Width="440"
          MaxHeight="520"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource Fate.Brush.SurfaceRaised}"
          BorderBrush="{DynamicResource Fate.Brush.PanelEdge}"
          BorderThickness="1"
          CornerRadius="{DynamicResource Fate.Radius.Lg}"
          Padding="20"
          Effect="{DynamicResource Fate.Effect.PanelShadow}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource Fate.Text.Subtitle}" Text="Pick an entity" />

            <TextBox
              Grid.Row="1"
              Margin="0,12,0,0"
              Style="{StaticResource Fate.TextBox}"
              Text="{Binding PickerQuery, UpdateSourceTrigger=PropertyChanged}"
              AutomationProperties.Name="Search entities" />

            <ListBox
              Grid.Row="2"
              Margin="0,10,0,0"
              MaxHeight="300"
              Style="{StaticResource Fate.ListBox}"
              ItemsSource="{Binding PickerResults}"
              SelectedItem="{Binding PickerSelection}"
              MouseDoubleClick="OnPickerDoubleClick">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Margin" Value="0,0,0,4" />
                  <Setter Property="Cursor" Value="Hand" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border
                          x:Name="Face"
                          Padding="10,7"
                          Background="Transparent"
                          CornerRadius="{DynamicResource Fate.Radius.Sm}">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource Fate.Brush.SurfaceHighest}" />
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource Fate.Brush.AccentSubtle}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PickerEntity}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Fate.Text.Body}" Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Fate.Text.Faint}" Text="{Binding Detail}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
              <Button
                Style="{StaticResource Fate.Button.Primary}"
                Content="Add"
                Command="{Binding ConfirmPickCommand}" />
              <Button Margin="8,0,0,0" Content="Cancel" Command="{Binding CancelPickCommand}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </ContentControl>
</UserControl>
