<UserControl
  x:Class="FateTakesYouHome.Views.Pages.DashboardPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:FateTakesYouHome.Controls"
  xmlns:conv="clr-namespace:FateTakesYouHome.Converters"
  xmlns:vm="clr-namespace:FateTakesYouHome.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

  <UserControl.Resources>
    <conv:CountToVisibilityConverter x:Key="AnyToVisibility" />
    <conv:CountToVisibilityConverter x:Key="NoneToVisibility" WhenEmpty="True" />
    <conv:WidthToColumnsConverter x:Key="WidthToColumns" />
  </UserControl.Resources>

  <ContentControl Style="{StaticResource Fate.Panel}">
    <Grid Margin="26,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ============================================================ heading -->

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <c:TrackedTextBlock Style="{StaticResource Fate.Display.SectionLabel}" Text="Home" />
          <TextBlock
            Margin="0,8,0,0"
            Style="{StaticResource Fate.Text.Subtitle}"
            FontSize="{DynamicResource Fate.Size.Title}"
            Text="{Binding Greeting}"
            TextWrapping="Wrap" />
        </StackPanel>

        <Button
          Grid.Column="1"
          VerticalAlignment="Top"
          Style="{StaticResource Fate.Button.Primary}"
          Content="Turn off all lights"
          Command="{Binding TurnOffAllLightsCommand}" />
      </Grid>

      <TextBlock
        Grid.Row="0"
        VerticalAlignment="Bottom"
        HorizontalAlignment="Right"
        Style="{StaticResource Fate.Text.Caption}"
        Foreground="{DynamicResource Fate.Brush.TextFaint}"
        Text="{Binding LastActionMessage}" />

      <!-- ============================================================ activity -->

      <ItemsControl
        Grid.Row="1"
        Margin="0,20,0,0"
        ItemsSource="{Binding Activity}"
        Visibility="{Binding Activity.Count, Converter={StaticResource AnyToVisibility}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ActivitySummary}">
            <Border
              Margin="0,0,10,10"
              Padding="14,9"
              Background="{DynamicResource Fate.Brush.SurfaceOverlay}"
              BorderBrush="{DynamicResource Fate.Brush.BorderSubtle}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Fate.Radius.Pill}">
              <StackPanel Orientation="Horizontal">
                <TextBlock
                  Style="{StaticResource Fate.Text.Body}"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource Fate.Brush.TextAccent}"
                  Text="{Binding Count}" />
                <TextBlock
                  Margin="7,0,0,0"
                  Style="{StaticResource Fate.Text.Caption}"
                  VerticalAlignment="Center"
                  Text="{Binding Label}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ============================================================ pinned + rooms -->

      <ScrollViewer Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource Fate.ScrollViewer}">
        <StackPanel Margin="0,0,10,0">

          <!-- The arranged grid, when the user has built one in the layout editor. -->
          <ItemsControl
            ItemsSource="{Binding Widgets}"
            ItemContainerStyle="{StaticResource Fate.WidgetContainer}"
            Visibility="{Binding UsesCustomLayout, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <c:WidgetCanvas Columns="6" RowHeight="84" Gap="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <StackPanel Visibility="{Binding UsesCustomLayout, Converter={StaticResource InverseBoolToVisibility}}">

          <!-- Pinned tiles. -->
          <c:TrackedTextBlock
            Style="{StaticResource Fate.Display.SectionLabel}"
            Text="Pinned"
            Visibility="{Binding Pinned.Count, Converter={StaticResource AnyToVisibility}}" />

          <ItemsControl
            Margin="0,10,0,0"
            ItemsSource="{Binding Pinned}"
            ItemTemplate="{StaticResource Fate.Template.EntityTile}"
            VerticalAlignment="Top"
            Visibility="{Binding Pinned.Count, Converter={StaticResource AnyToVisibility}}">
            <!--
              VerticalAlignment=Top is load-bearing. A ScrollViewer arranges its content to at
              least the viewport height, and UniformGrid divides whatever height it is given evenly
              among its rows - so without this, three pinned tiles each stretched to half the window.
            -->
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- One column on a cramped window, three on a generous one. -->
                <UniformGrid
                  Columns="{Binding ActualWidth,
                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                    Converter={StaticResource WidthToColumns}}"
                  VerticalAlignment="Top" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Margin" Value="0,0,10,10" />
              </Style>
            </ItemsControl.ItemContainerStyle>
          </ItemsControl>

          <!-- No pins yet: an invitation, not a wall. Rooms below still render. -->
          <Border
            Style="{StaticResource Fate.Card}"
            Padding="18,16"
            Visibility="{Binding Pinned.Count, Converter={StaticResource NoneToVisibility}}">
            <StackPanel>
              <TextBlock Style="{StaticResource Fate.Text.Subtitle}" Text="Nothing pinned yet" />
              <TextBlock
                Margin="0,6,0,0"
                Style="{StaticResource Fate.Text.Muted}"
                TextWrapping="Wrap"
                Text="Pin the lights, scenes and automations you reach for most. They will appear here and in the tray panel." />
              <Button
                Margin="0,14,0,0"
                HorizontalAlignment="Left"
                Content="Browse everything"
                Command="{Binding BrowseEntitiesCommand}" />
            </StackPanel>
          </Border>

          <!-- Rooms: every area that has lights, lit rooms first. Click one to see the room. -->
          <c:TrackedTextBlock
            Margin="0,20,0,0"
            Style="{StaticResource Fate.Display.SectionLabel}"
            Text="Rooms"
            Visibility="{Binding Rooms.Count, Converter={StaticResource AnyToVisibility}}" />

          <ItemsControl
            Margin="0,10,0,6"
            ItemsSource="{Binding Rooms}"
            Visibility="{Binding Rooms.Count, Converter={StaticResource AnyToVisibility}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:RoomSummary}">
                <Button
                  Margin="0,0,10,10"
                  Command="{Binding DataContext.OpenRoomCommand,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  CommandParameter="{Binding}"
                  ToolTip="{Binding Name}"
                  AutomationProperties.Name="{Binding Name}"
                  AutomationProperties.HelpText="{Binding Detail}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border
                        x:Name="Face"
                        Width="150"
                        Padding="14,11"
                        Background="{DynamicResource Fate.Brush.SurfaceOverlay}"
                        BorderBrush="{DynamicResource Fate.Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Fate.Radius.Md}"
                        Cursor="Hand">
                        <StackPanel>
                          <TextBlock
                            Style="{StaticResource Fate.Text.Body}"
                            FontWeight="Medium"
                            TextTrimming="CharacterEllipsis"
                            Text="{Binding Name}" />
                          <TextBlock
                            x:Name="Detail"
                            Margin="0,3,0,0"
                            Style="{StaticResource Fate.Text.Caption}"
                            Text="{Binding Detail}" />
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLit}" Value="True">
                          <Setter TargetName="Detail" Property="Foreground"
                                  Value="{DynamicResource Fate.Brush.TextAccent}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Face" Property="Background"
                                  Value="{DynamicResource Fate.Brush.SurfaceHighest}" />
                          <Setter TargetName="Face" Property="BorderBrush"
                                  Value="{DynamicResource Fate.Brush.BorderDefault}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter TargetName="Face" Property="BorderBrush"
                                  Value="{DynamicResource Fate.Brush.AccentDefault}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </ContentControl>
</UserControl>
