<UserControl
  x:Class="FateTakesYouHome.Views.Pages.DashboardPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:FateTakesYouHome.Controls"
  xmlns:conv="clr-namespace:FateTakesYouHome.Converters"
  xmlns:vm="clr-namespace:FateTakesYouHome.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

  <UserControl.Resources>
    <conv:CountToVisibilityConverter x:Key="AnyToVisibility" />
    <conv:CountToVisibilityConverter x:Key="NoneToVisibility" WhenEmpty="True" />
  </UserControl.Resources>

  <ContentControl Style="{StaticResource Fate.Panel}">
    <Grid Margin="26,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ============================================================ heading -->

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <c:TrackedTextBlock Style="{StaticResource Fate.Display.SectionLabel}" Text="Home" />
          <TextBlock
            Margin="0,8,0,0"
            Style="{StaticResource Fate.Text.Subtitle}"
            FontSize="{DynamicResource Fate.Size.Title}"
            Text="{Binding Greeting}"
            TextWrapping="Wrap" />
        </StackPanel>

        <Button
          Grid.Column="1"
          VerticalAlignment="Top"
          Content="Turn off all lights"
          Command="{Binding TurnOffAllLightsCommand}" />
      </Grid>

      <TextBlock
        Grid.Row="0"
        VerticalAlignment="Bottom"
        HorizontalAlignment="Right"
        Style="{StaticResource Fate.Text.Caption}"
        Foreground="{DynamicResource Fate.Brush.TextFaint}"
        Text="{Binding LastActionMessage}" />

      <!-- ============================================================ activity -->

      <ItemsControl
        Grid.Row="1"
        Margin="0,20,0,0"
        ItemsSource="{Binding Activity}"
        Visibility="{Binding Activity.Count, Converter={StaticResource AnyToVisibility}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ActivitySummary}">
            <Border
              Margin="0,0,10,10"
              Padding="14,9"
              Background="{DynamicResource Fate.Brush.SurfaceOverlay}"
              BorderBrush="{DynamicResource Fate.Brush.BorderSubtle}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Fate.Radius.Pill}">
              <StackPanel Orientation="Horizontal">
                <TextBlock
                  Style="{StaticResource Fate.Text.Body}"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource Fate.Brush.TextAccent}"
                  Text="{Binding Count}" />
                <TextBlock
                  Margin="7,0,0,0"
                  Style="{StaticResource Fate.Text.Caption}"
                  VerticalAlignment="Center"
                  Text="{Binding Label}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ============================================================ pinned -->

      <Grid Grid.Row="2" Margin="0,14,0,0">
        <ScrollViewer
          Style="{StaticResource Fate.ScrollViewer}"
          Visibility="{Binding Pinned.Count, Converter={StaticResource AnyToVisibility}}">
          <ItemsControl
            ItemsSource="{Binding Pinned}"
            ItemTemplate="{StaticResource Fate.Template.EntityTile}"
            Margin="0,0,10,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- Two columns on a wide window, one when narrow. -->
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Margin" Value="0,0,10,10" />
              </Style>
            </ItemsControl.ItemContainerStyle>
          </ItemsControl>
        </ScrollViewer>

        <!-- Empty state. -->
        <StackPanel
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
          MaxWidth="440"
          Visibility="{Binding Pinned.Count, Converter={StaticResource NoneToVisibility}}">
          <TextBlock
            Style="{StaticResource Fate.Text.Subtitle}"
            HorizontalAlignment="Center"
            Text="Nothing pinned yet" />
          <TextBlock
            Margin="0,8,0,0"
            Style="{StaticResource Fate.Text.Muted}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Text="Pin the lights, scenes and automations you reach for most. They will appear here and in the tray panel." />
          <Button
            Margin="0,18,0,0"
            HorizontalAlignment="Center"
            Content="Browse everything"
            Command="{Binding BrowseEntitiesCommand}" />
        </StackPanel>
      </Grid>
    </Grid>
  </ContentControl>
</UserControl>
