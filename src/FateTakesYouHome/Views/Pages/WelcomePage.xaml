<UserControl
  x:Class="FateTakesYouHome.Views.Pages.WelcomePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:FateTakesYouHome.Controls">

  <ContentControl Style="{StaticResource Fate.Panel}">
    <Grid Margin="48,40">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
        <!--
          The mark with a real halo behind it. In the reference product the glow is most of what
          makes the logo feel lit rather than pasted on; a bare bitmap on navy looks like a sticker.
        -->
        <Grid Width="150" Height="150" HorizontalAlignment="Center">
          <Ellipse IsHitTestVisible="False">
            <Ellipse.Fill>
              <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Offset="0.15" Color="{DynamicResource Fate.Color.AccentGlow}" />
                <GradientStop Offset="1" Color="Transparent" />
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>

          <Image
            x:Name="Mark"
            Width="84"
            Height="84"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>

        <c:TrackedTextBlock
          Margin="0,18,0,0"
          HorizontalAlignment="Center"
          Style="{StaticResource Fate.Display.PageTitle}"
          FontSize="42"
          Tracking="{DynamicResource Fate.Tracking.Wordmark}"
          UpperCase="True"
          Foreground="{DynamicResource Fate.Brush.TextAccent}"
          Text="Fate Takes You Home" />

        <!--
          The brand's voice rule: state the concrete promise plainly, then turn mythic in the last
          clause. Everything functional below this stays functional.
        -->
        <TextBlock
          Margin="0,16,0,0"
          HorizontalAlignment="Center"
          TextAlignment="Center"
          Style="{StaticResource Fate.Text.Muted}"
          FontSize="{DynamicResource Fate.Size.Subtitle}"
          LineHeight="26"
          TextWrapping="Wrap"
          Text="Your lights, scenes and automations, one click from the taskbar — so the house is ready before you are." />

        <c:TrackedTextBlock
          Margin="0,16,0,0"
          HorizontalAlignment="Center"
          Style="{StaticResource Fate.Display.SectionLabel}"
          Text="Provided by VagueDustin Enterprises™" />

        <Border Style="{StaticResource Fate.Divider}" Margin="0,30,0,0" />

        <TextBlock
          Margin="0,22,0,0"
          HorizontalAlignment="Center"
          TextAlignment="Center"
          Style="{StaticResource Fate.Text.Body}"
          TextWrapping="Wrap"
          LineHeight="22"
          Text="Setting this up takes about two minutes. You will need your Home Assistant address and a Long-Lived Access Token, which you create from your Home Assistant profile page." />

        <StackPanel Orientation="Horizontal" Margin="0,28,0,0" HorizontalAlignment="Center">
          <Button
            x:Name="StartButton"
            Style="{StaticResource Fate.Button.Primary}"
            Content="Set up the connection"
            Click="OnStartClicked" />

          <Button
            Margin="10,0,0,0"
            Content="Show me around first"
            Click="OnTourClicked" />

          <Button
            Margin="10,0,0,0"
            Content="Skip"
            Click="OnSkipClicked" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="2" HorizontalAlignment="Center" MaxWidth="620">
        <TextBlock
          Style="{StaticResource Fate.Text.Faint}"
          TextAlignment="Center"
          TextWrapping="Wrap"
          Text="Nothing leaves this machine. The app talks directly to your Home Assistant instance, and your access token is encrypted with Windows data protection so only your account can read it." />
      </StackPanel>
    </Grid>
  </ContentControl>
</UserControl>
