<UserControl
  x:Class="FateTakesYouHome.Views.Pages.ShortcutsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:FateTakesYouHome.Controls"
  xmlns:conv="clr-namespace:FateTakesYouHome.Converters"
  xmlns:vm="clr-namespace:FateTakesYouHome.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:ShortcutsViewModel}">

  <UserControl.Resources>
    <conv:NullOrEmptyToVisibilityConverter x:Key="TextToVisibility" />
    <conv:CountToVisibilityConverter x:Key="AnyToVisibility" />
    <conv:CountToVisibilityConverter x:Key="EmptyToVisibility" WhenEmpty="True" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!--
      One suggestion in the device picker: a flat row that lights on hover and rings on focus.
      A button rather than a list item because choosing one is an action, not a selection. The
      house list items are deliberately inert, and a selection that does nothing until a second
      control is found is the trap this replaces.
    -->
    <Style x:Key="SuggestionButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border
                x:Name="Row"
                Background="Transparent"
                CornerRadius="{DynamicResource Fate.Radius.Md}"
                Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
              </Border>
              <Border
                x:Name="FocusRing"
                BorderBrush="{DynamicResource Fate.Brush.AccentHover}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Fate.Radius.Md}"
                Opacity="0"
                IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Fate.Brush.ButtonFaceHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Fate.Brush.ButtonFacePressed}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Fate.Brush.ButtonFaceHover}" />
                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ContentControl Style="{StaticResource Fate.Panel}">
    <ScrollViewer Style="{StaticResource Fate.ScrollViewer}">
      <StackPanel Margin="26,22,36,26">

        <c:TrackedTextBlock Style="{StaticResource Fate.Display.SectionLabel}" Text="Shortcuts" />

        <!-- ================================================ application -->

        <TextBlock Margin="0,14,0,0" Style="{StaticResource Fate.Text.Subtitle}" Text="Application" />
        <TextBlock
          Margin="0,4,0,0"
          Style="{StaticResource Fate.Text.Faint}"
          TextWrapping="Wrap"
          Text="Keys for the app itself. Like every key on this page they work from anywhere in Windows, even while another app has focus. Click a box and press the combination; Escape clears it." />

        <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Shortcuts}" MaxWidth="760" HorizontalAlignment="Left">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ShortcutRow}">
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Fate.Text.Body}" FontWeight="Medium" Text="{Binding Label}" />
                  <TextBlock Margin="0,2,0,0" Style="{StaticResource Fate.Text.Faint}"
                             TextWrapping="Wrap" Text="{Binding Description}" />
                  <TextBlock
                    Margin="0,3,0,0"
                    Style="{StaticResource Fate.Text.Caption}"
                    Foreground="{DynamicResource Fate.Brush.StatusWarning}"
                    TextWrapping="Wrap"
                    Text="{Binding Failure}"
                    Visibility="{Binding Failure, Converter={StaticResource TextToVisibility}}" />
                </StackPanel>

                <c:ShortcutBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Style="{StaticResource Fate.TextBox}"
                  Padding="9,7"
                  GestureText="{Binding Gesture}"
                  AutomationProperties.Name="{Binding Label}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ==================================================== devices -->

        <Border Style="{StaticResource Fate.Divider}" Margin="0,22" />

        <TextBlock Style="{StaticResource Fate.Text.Subtitle}" Text="Devices" />
        <TextBlock
          Margin="0,4,0,0"
          MaxWidth="760"
          HorizontalAlignment="Left"
          Style="{StaticResource Fate.Text.Faint}"
          TextWrapping="Wrap"
          Text="Keys that act on the devices you choose. Pick several and they act as one: a toggle turns them all off if any are on, and all on otherwise." />

        <TextBlock
          Margin="0,14,0,0"
          Style="{StaticResource Fate.Text.Faint}"
          Text="No device shortcuts yet."
          Visibility="{Binding DeviceShortcuts.Count, Converter={StaticResource EmptyToVisibility}}" />

        <ItemsControl
          Margin="0,14,0,0"
          MaxWidth="760"
          HorizontalAlignment="Stretch"
          ItemsSource="{Binding DeviceShortcuts}"
          Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DeviceShortcutRow}">
              <Border Style="{StaticResource Fate.Card}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="200" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="170" />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <c:ShortcutBox
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      Style="{StaticResource Fate.TextBox}"
                      Padding="9,7"
                      GestureText="{Binding Gesture}"
                      AutomationProperties.Name="{Binding Summary, StringFormat='Keys for {0}'}" />

                    <ComboBox
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Style="{StaticResource Fate.ComboBox}"
                      ItemsSource="{x:Static vm:DeviceShortcutRow.Actions}"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Action}"
                      AutomationProperties.Name="Action">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DeviceActionChoice}">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid
                      Grid.Column="4"
                      VerticalAlignment="Center"
                      Visibility="{Binding TakesValue, Converter={StaticResource BoolToVisibility}}">
                      <Slider
                        Style="{StaticResource Fate.Slider}"
                        Minimum="{Binding ValueMinimum}"
                        Maximum="100"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        SmallChange="5"
                        LargeChange="10"
                        Value="{Binding Value}"
                        Margin="0,0,48,0"
                        AutomationProperties.Name="{Binding ValueLabel, StringFormat='Brightness {0}'}" />
                      <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource Fate.Text.Mono}"
                        Text="{Binding Value, StringFormat={}{0:0}%}" />
                    </Grid>

                    <Button
                      Grid.Column="5"
                      Margin="10,0,0,0"
                      VerticalAlignment="Center"
                      Style="{StaticResource Fate.Button.Icon}"
                      ToolTip="Remove this shortcut"
                      AutomationProperties.Name="{Binding Summary, StringFormat='Remove shortcut: {0}'}"
                      Command="{Binding RemoveCommand}">
                      <Path Style="{StaticResource Fate.UiIcon}" Data="{StaticResource Fate.Icon.Trash}" />
                    </Button>
                  </Grid>

                  <!-- The devices it acts on. -->
                  <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Targets}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:DeviceShortcutTarget}">
                        <Border
                          Margin="0,0,8,8"
                          Padding="10,0,2,0"
                          CornerRadius="{DynamicResource Fate.Radius.Md}"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource Fate.Brush.BorderDefault}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" ToolTip="{Binding EntityId}">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Fate.Text.Body}">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                      <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextFaint}" />
                                      <Setter Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <Button
                              Margin="4,0,0,0"
                              Style="{StaticResource Fate.Button.Icon}"
                              Width="26"
                              Height="26"
                              BorderThickness="0"
                              ToolTip="Remove"
                              AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}"
                              Command="{Binding DataContext.RemoveTargetCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}">
                              <Path Style="{StaticResource Fate.UiIcon}" Width="10" Height="10" Data="{StaticResource Fate.Icon.Close}" />
                            </Button>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!--
                    Finding a device to add. The suggestions show while the search box, or one of
                    the suggestions, has focus; each is a button, so a click, Enter or Space adds it.
                    Enter in the search box adds the top match.
                  -->
                  <StackPanel x:Name="Picker" Margin="0,4,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Grid Grid.Column="0">
                        <TextBox
                          x:Name="DeviceSearch"
                          Style="{StaticResource Fate.TextBox}"
                          Padding="9,7"
                          Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                          PreviewKeyDown="OnSearchPreviewKeyDown"
                          AutomationProperties.Name="Find a device to add"
                          ToolTip="Type part of a device's or room's name. Enter adds the top match; the down arrow moves into the list.">
                          <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddTargetCommand}" />
                          </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False"
                          Text="Find a device to add…">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Fate.Text.Faint}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SearchText}" Value="" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=DeviceSearch}" Value="False" />
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>

                      <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource Fate.Button}"
                        Content="Add device"
                        AutomationProperties.Name="Add the top match"
                        Command="{Binding AddTargetCommand}" />
                    </Grid>

                    <Border
                      Margin="0,6,0,0"
                      Padding="4"
                      CornerRadius="{DynamicResource Fate.Radius.Md}"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource Fate.Brush.BorderSubtle}"
                      Background="{DynamicResource Fate.Brush.SurfaceSunken}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Picker}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- Declared last so it wins: an empty list is not worth a box. -->
                            <DataTrigger Binding="{Binding Matches.Count}" Value="0">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>

                      <ScrollViewer Style="{StaticResource Fate.ScrollViewer}" MaxHeight="260" Focusable="False">
                        <ItemsControl
                          ItemsSource="{Binding Matches}"
                          Focusable="False"
                          AutomationProperties.Name="Matching devices">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceShortcutMatch}">
                              <Button
                                Style="{StaticResource SuggestionButton}"
                                Command="{Binding DataContext.AddTargetCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Click="OnSuggestionClicked"
                                ToolTip="{Binding EntityId}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Add {0}'}">
                                <StackPanel>
                                  <TextBlock Style="{StaticResource Fate.Text.Body}" Text="{Binding Name}" />
                                  <TextBlock Style="{StaticResource Fate.Text.Caption}" Text="{Binding Detail}" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>

                  <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource Fate.Text.Faint}"
                    TextWrapping="Wrap"
                    Text="{Binding Note}"
                    Visibility="{Binding Note, Converter={StaticResource TextToVisibility}}" />
                  <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource Fate.Text.Caption}"
                    Foreground="{DynamicResource Fate.Brush.StatusWarning}"
                    TextWrapping="Wrap"
                    Text="{Binding Failure}"
                    Visibility="{Binding Failure, Converter={StaticResource TextToVisibility}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button
          Margin="0,4,0,0"
          HorizontalAlignment="Left"
          Style="{StaticResource Fate.Button}"
          Content="Add a device shortcut"
          AutomationProperties.Name="Add a device shortcut"
          Command="{Binding AddDeviceShortcutCommand}" />
      </StackPanel>
    </ScrollViewer>
  </ContentControl>
</UserControl>
