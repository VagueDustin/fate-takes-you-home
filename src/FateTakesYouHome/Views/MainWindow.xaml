<Window
  x:Class="FateTakesYouHome.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  xmlns:c="clr-namespace:FateTakesYouHome.Controls"
  xmlns:conv="clr-namespace:FateTakesYouHome.Converters"
  xmlns:pages="clr-namespace:FateTakesYouHome.Views.Pages"
  xmlns:onboarding="clr-namespace:FateTakesYouHome.Onboarding"
  xmlns:vm="clr-namespace:FateTakesYouHome.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
  Title="Fate Takes You Home"
  Width="1120"
  Height="760"
  MinWidth="820"
  MinHeight="560"
  WindowStartupLocation="CenterScreen"
  Background="{DynamicResource Fate.Brush.WindowBackground}"
  Foreground="{DynamicResource Fate.Brush.TextPrimary}"
  FontFamily="{DynamicResource Fate.Font.Body}"
  UseLayoutRounding="True"
  TextOptions.TextFormattingMode="Ideal">

  <!--
    Custom chrome rather than the system title bar. WindowChrome keeps every native behaviour —
    snapping, aero shake, the system menu, resize borders — while letting the caption be drawn in
    the theme, which is the difference between a themed app and an app with a themed body and a
    grey hat.
  -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome
      CaptionHeight="44"
      ResizeBorderThickness="6"
      CornerRadius="0"
      GlassFrameThickness="0"
      UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <conv:SectionToVisibilityConverter x:Key="SectionToVisibility" />
    <conv:IsNarrowerThanConverter x:Key="IsNarrowerThan" />
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Modifiers="Alt" Key="Left" Command="{Binding GoBackCommand}" />
    <KeyBinding Modifiers="Alt" Key="Right" Command="{Binding GoForwardCommand}" />
  </Window.InputBindings>

  <Grid x:Name="RootLayer">
    <!--
      The night sky. Rendered once to a bitmap when the theme is applied and drawn as a plain
      image, so it costs nothing per frame. This is the atmosphere the house look depends on — a
      flat navy fill reads as a form, not as depth.
    -->
    <Rectangle
      Fill="{DynamicResource Fate.Brush.Starfield}"
      Visibility="{DynamicResource Fate.Visibility.Starfield}"
      IsHitTestVisible="False"
      Panel.ZIndex="-1" />

    <!-- The sky breathes: a dozen twinkles and the odd meteor, over the static bitmap. -->
    <c:StarfieldAnimation
      Visibility="{DynamicResource Fate.Visibility.Starfield}"
      Panel.ZIndex="-1" />

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============================================================ title bar -->

      <Grid Grid.Row="0" Height="44" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel
          Grid.Column="0"
          Orientation="Horizontal"
          Margin="6,0,0,0"
          VerticalAlignment="Center"
          shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <!-- Browser-grammar back button: rooms, searches and pages all stack behind it. -->
          <Button
            Style="{StaticResource Fate.Button.Caption}"
            Width="40"
            Command="{Binding GoBackCommand}"
            IsEnabled="{Binding CanGoBack}"
            ToolTip="Back (Alt+Left, or the mouse's back button)"
            AutomationProperties.Name="Back">
            <Button.Resources>
              <Style TargetType="Path" BasedOn="{StaticResource Fate.UiIcon}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CanGoBack}" Value="False">
                    <Setter Property="Opacity" Value="0.3" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Resources>
            <Path Width="13" Height="13" Data="{StaticResource Fate.Icon.Back}" />
          </Button>

          <Image
            x:Name="TitleMark"
            Width="18"
            Height="18"
            Margin="6,0,10,0"
            RenderOptions.BitmapScalingMode="HighQuality" />
          <c:TrackedTextBlock
            Style="{StaticResource Fate.Display.Wordmark}"
            FontSize="{DynamicResource Fate.Size.Caption}"
            Text="Fate Takes You Home"
            VerticalAlignment="Center" />
        </StackPanel>

        <!-- Caption buttons. Excluded from the drag region or they cannot be clicked. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button
            x:Name="MinimiseButton"
            Style="{StaticResource Fate.Button.Caption}"
            Click="OnMinimiseClicked"
            ToolTip="Minimise"
            AutomationProperties.Name="Minimise">
            <Path Style="{StaticResource Fate.UiIcon}" Width="13" Height="13" Data="{StaticResource Fate.Icon.Minimise}" />
          </Button>
          <Button
            x:Name="MaximiseButton"
            Style="{StaticResource Fate.Button.Caption}"
            Click="OnMaximiseClicked"
            ToolTip="Maximise"
            AutomationProperties.Name="Maximise">
            <Path Style="{StaticResource Fate.UiIcon}" Width="12" Height="12" Data="{StaticResource Fate.Icon.Maximise}" />
          </Button>
          <Button
            x:Name="CloseButton"
            Style="{StaticResource Fate.Button.CaptionClose}"
            Click="OnCloseClicked"
            ToolTip="Close"
            AutomationProperties.Name="Close" />
        </StackPanel>
      </Grid>

      <!-- ============================================================ banners -->

      <StackPanel Grid.Row="1">

      <!-- A newer release exists. Gold-edged: an invitation, not an alarm. -->
      <Border
        Margin="16,0,16,10"
        Padding="14,10"
        CornerRadius="{DynamicResource Fate.Radius.Md}"
        Background="{DynamicResource Fate.Brush.SurfaceRaised}"
        BorderBrush="{DynamicResource Fate.Brush.AccentDefault}"
        BorderThickness="1"
        Visibility="{Binding ShowsUpdateBanner, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock
            Grid.Column="0"
            VerticalAlignment="Center"
            Style="{StaticResource Fate.Text.Body}"
            Text="{Binding Updates.Detail}"
            TextWrapping="Wrap" />

          <Button
            Grid.Column="1"
            Margin="12,0,0,0"
            Style="{StaticResource Fate.Button.Primary}"
            Content="Install and restart"
            Command="{Binding Updates.InstallCommand}" />

          <Button
            Grid.Column="2"
            Margin="8,0,0,0"
            Content="Later"
            Command="{Binding DismissUpdateBannerCommand}" />
        </Grid>
      </Border>

      <!-- Settings writes are failing: everything looks fine and nothing survives a restart,
           which is exactly the kind of problem that must not be left to the log file. -->
      <Border
        Margin="16,0,16,10"
        Padding="14,10"
        CornerRadius="{DynamicResource Fate.Radius.Md}"
        Background="{DynamicResource Fate.Brush.SurfaceRaised}"
        BorderBrush="{DynamicResource Fate.Brush.StatusDanger}"
        BorderThickness="1"
        Visibility="{Binding ShowsSaveBanner, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Path
            Grid.Column="0"
            Style="{StaticResource Fate.UiIcon}"
            Data="{StaticResource Fate.Icon.Warning}"
            Stroke="{DynamicResource Fate.Brush.StatusDanger}"
            Margin="0,0,10,0"
            VerticalAlignment="Center" />

          <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            Style="{StaticResource Fate.Text.Body}"
            Text="{Binding SaveBannerText}"
            TextWrapping="Wrap" />

          <Button
            Grid.Column="2"
            Margin="12,0,0,0"
            Content="Try again"
            Command="{Binding RetrySaveCommand}" />
        </Grid>
      </Border>

      <Border
        Margin="16,0,16,10"
        Padding="14,10"
        CornerRadius="{DynamicResource Fate.Radius.Md}"
        Background="{DynamicResource Fate.Brush.SurfaceRaised}"
        BorderBrush="{DynamicResource Fate.Brush.StatusWarning}"
        BorderThickness="1"
        Visibility="{Binding ShowsConnectionBanner, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Path
            Grid.Column="0"
            Style="{StaticResource Fate.UiIcon}"
            Data="{StaticResource Fate.Icon.Warning}"
            Stroke="{DynamicResource Fate.Brush.StatusWarning}"
            Margin="0,0,10,0"
            VerticalAlignment="Center" />

          <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            Style="{StaticResource Fate.Text.Body}"
            Text="{Binding ConnectionBannerText}"
            TextWrapping="Wrap" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
            <Button
              Style="{StaticResource Fate.Button.Primary}"
              Content="Settings"
              Command="{Binding GoToSettingsCommand}" />
            <Button Margin="8,0,0,0" Content="Retry" Command="{Binding ReconnectCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      </StackPanel>

      <!-- ============================================================ body -->

      <Grid Grid.Row="2" Margin="16,0,16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail. Deliberately not a card: the rail sits directly on the night
             sky, so the window reads as one surface with floating panels instead of a grid of
             nested grey boxes. -->
        <Grid
          x:Name="NavigationRail"
          Grid.Column="0"
          Margin="0,2,16,0">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Width" Value="188" />
              <Style.Triggers>
                <!-- A cramped window gets an icon rail; labels return with the room for them. -->
                <DataTrigger
                  Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                            Converter={StaticResource IsNarrowerThan}, ConverterParameter=980}"
                  Value="True">
                  <Setter Property="Width" Value="58" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ItemsControl Grid.Row="0" ItemsSource="{Binding NavigationItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:NavigationItem}">
                <RadioButton
                  GroupName="MainNavigation"
                  Margin="0,0,0,4"
                  Cursor="Hand"
                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                  ToolTip="{Binding Description}"
                  AutomationProperties.Name="{Binding Label}"
                  AutomationProperties.HelpText="{Binding Description}">
                  <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                      <Border
                        x:Name="Face"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Fate.Radius.Md}"
                        Padding="10,9">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>

                          <Path
                            x:Name="Icon"
                            Grid.Column="0"
                            Style="{StaticResource Fate.UiIcon}"
                            Data="{Binding Icon}"
                            Margin="0,0,11,0"
                            VerticalAlignment="Center" />

                          <TextBlock
                            x:Name="Label"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{Binding Label}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource Fate.Text.Body}">
                                <Style.Triggers>
                                  <DataTrigger
                                    Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                              Converter={StaticResource IsNarrowerThan}, ConverterParameter=980}"
                                    Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Grid>
                      </Border>

                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Face" Property="Background"
                                  Value="{DynamicResource Fate.Brush.SurfaceHighest}" />
                          <Setter TargetName="Label" Property="Foreground"
                                  Value="{DynamicResource Fate.Brush.TextPrimary}" />
                        </Trigger>

                        <!-- A gold-outlined pill, as the reference product does it. A tinted fill
                             alone was too quiet to tell you where you were. -->
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Face" Property="Background"
                                  Value="{DynamicResource Fate.Brush.AccentSubtle}" />
                          <Setter TargetName="Face" Property="BorderBrush"
                                  Value="{DynamicResource Fate.Brush.AccentDefault}" />
                          <Setter TargetName="Face" Property="BorderThickness" Value="1" />
                          <Setter TargetName="Icon" Property="Stroke"
                                  Value="{DynamicResource Fate.Brush.AccentDefault}" />
                          <Setter TargetName="Label" Property="Foreground"
                                  Value="{DynamicResource Fate.Brush.TextAccent}" />
                          <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter TargetName="Face" Property="BorderBrush"
                                  Value="{DynamicResource Fate.Brush.AccentHover}" />
                          <Setter TargetName="Face" Property="BorderThickness" Value="1" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </RadioButton.Template>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Where the app stands, at the foot of the rail: connected and to what. -->
          <Border
            Grid.Row="1"
            Margin="2,10,2,4"
            Padding="10,9"
            Background="{DynamicResource Fate.Brush.SurfaceOverlay}"
            BorderBrush="{DynamicResource Fate.Brush.BorderSubtle}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Fate.Radius.Md}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border
                Grid.Column="0"
                Width="8"
                Height="8"
                Margin="0,2,8,0"
                VerticalAlignment="Top"
                CornerRadius="4">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Fate.Brush.StatusWarning}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Fate.Brush.StatusSuccess}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
              </Border>

              <TextBlock
                Grid.Column="1"
                Text="{Binding ConnectionSummary}"
                TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Fate.Text.Caption}">
                    <Style.Triggers>
                      <DataTrigger
                        Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                  Converter={StaticResource IsNarrowerThan}, ConverterParameter=980}"
                        Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>
        </Grid>

        <!-- Pages. All present; only one visible. -->
        <Grid Grid.Column="1" x:Name="PageHost">
          <pages:WelcomePage
            x:Name="WelcomePage"
            Visibility="{Binding CurrentSection, Converter={StaticResource SectionToVisibility},
                                 ConverterParameter=Welcome}" />

          <pages:DashboardPage
            x:Name="DashboardPage"
            DataContext="{Binding Dashboard}"
            Visibility="{Binding DataContext.CurrentSection,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource SectionToVisibility},
                                 ConverterParameter=Dashboard}" />

          <pages:EntitiesPage
            x:Name="EntitiesPage"
            DataContext="{Binding Entities}"
            Visibility="{Binding DataContext.CurrentSection,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource SectionToVisibility},
                                 ConverterParameter=Entities}" />

          <pages:LayoutPage
            x:Name="LayoutPage"
            DataContext="{Binding Layout}"
            Visibility="{Binding DataContext.CurrentSection,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource SectionToVisibility},
                                 ConverterParameter=Layout}" />

          <pages:ThemesPage
            x:Name="ThemesPage"
            DataContext="{Binding Themes}"
            Visibility="{Binding DataContext.CurrentSection,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource SectionToVisibility},
                                 ConverterParameter=Themes}" />

          <pages:SettingsPage
            x:Name="SettingsPage"
            DataContext="{Binding Settings}"
            Visibility="{Binding DataContext.CurrentSection,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource SectionToVisibility},
                                 ConverterParameter=Settings}" />

          <pages:HelpPage
            x:Name="HelpPage"
            DataContext="{Binding Help}"
            Visibility="{Binding DataContext.CurrentSection,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource SectionToVisibility},
                                 ConverterParameter=Help}" />
        </Grid>
      </Grid>

      <!-- ============================================================ footer -->

      <!-- The publisher credit the brand requires on every property. -->
      <Grid Grid.Row="3" Margin="16,10,16,9">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
          Grid.Column="0"
          Style="{StaticResource Fate.Text.Faint}"
          Text="{Binding Source={x:Static vm:MainViewModel.FooterLine}}"
          TextTrimming="CharacterEllipsis"
          VerticalAlignment="Center" />

        <TextBlock
          Grid.Column="1"
          Style="{StaticResource Fate.Text.Faint}"
          Text="{Binding Source={x:Static vm:MainViewModel.VersionLine}}"
          VerticalAlignment="Center" />
      </Grid>
    </Grid>

    <!-- The guided tour draws over everything, including the title bar. -->
    <onboarding:CoachMarkOverlay x:Name="Tour" />
  </Grid>
</Window>
