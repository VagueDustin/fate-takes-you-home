<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:FateTakesYouHome.Controls">

  <!--
    The visual vocabulary.

    Every value comes from the live theme through DynamicResource, so a theme swap or a hot reload
    repaints without rebuilding a view. There are no colour, size or radius literals in this file;
    if you find yourself wanting one, it belongs in the theme instead.

    Motion is deliberately absent here. A WPF Storyboard inside a sealed template is frozen, which
    makes a theme-driven duration impossible in markup — animations live in ThemedMotion and the
    control code that calls it.
  -->

  <!-- ==================================================================== typography -->

  <Style x:Key="Fate.Text.Base" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Fate.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextPrimary}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>

  <Style x:Key="Fate.Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Fate.Text.Base}" />

  <Style x:Key="Fate.Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Fate.Text.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextMuted}" />
  </Style>

  <Style x:Key="Fate.Text.Faint" TargetType="TextBlock" BasedOn="{StaticResource Fate.Text.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextFaint}" />
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Caption}" />
  </Style>

  <Style x:Key="Fate.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Fate.Text.Base}">
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextMuted}" />
  </Style>

  <Style x:Key="Fate.Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Fate.Text.Base}">
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Subtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Fate.Text.Accent" TargetType="TextBlock" BasedOn="{StaticResource Fate.Text.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextAccent}" />
  </Style>

  <Style x:Key="Fate.Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Fate.Text.Base}">
    <Setter Property="FontFamily" Value="{DynamicResource Fate.Font.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextMuted}" />
  </Style>

  <!-- Cinzel, generously letterspaced. Page titles and the wordmark only. -->
  <Style x:Key="Fate.Display.Title" TargetType="c:TrackedTextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Fate.Font.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Title}" />
    <Setter Property="Tracking" Value="{DynamicResource Fate.Tracking.Display}" />
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextPrimary}" />
  </Style>

  <Style x:Key="Fate.Display.Wordmark" TargetType="c:TrackedTextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Fate.Font.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Subtitle}" />
    <Setter Property="Tracking" Value="{DynamicResource Fate.Tracking.Wordmark}" />
    <Setter Property="UpperCase" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextAccent}" />
  </Style>

  <!--
    Wide small caps in gold. The single most recognisable piece of the house style — and it has to
    be the accent, not a grey: in the reference product these labels are what carries the eye down
    the page, and a faint grey version reads as a disclaimer instead of a heading.
  -->
  <Style x:Key="Fate.Display.SectionLabel" TargetType="c:TrackedTextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Fate.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Tracking" Value="{DynamicResource Fate.Tracking.Label}" />
    <Setter Property="UpperCase" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextAccent}" />
  </Style>

  <!-- A page title: Cinzel, large, confident. -->
  <Style x:Key="Fate.Display.PageTitle" TargetType="c:TrackedTextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Fate.Font.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Display}" />
    <Setter Property="Tracking" Value="{DynamicResource Fate.Tracking.Display}" />
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextPrimary}" />
  </Style>

  <!-- ==================================================================== surfaces -->

  <!--
    A gilded panel: the depth wash, the two inset strokes from the brand's panel shadow, and the
    tier's optional grain and corner brackets. The inset strokes are what make a surface read as
    gilded rather than merely dark, so they are real borders rather than an approximated shadow.
  -->
  <Style x:Key="Fate.Panel" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border
            Background="{DynamicResource Fate.Brush.PanelWash}"
            BorderBrush="{DynamicResource Fate.Brush.PanelEdge}"
            BorderThickness="{DynamicResource Fate.Thickness.Stroke}"
            CornerRadius="{DynamicResource Fate.Radius.Lg}"
            SnapsToDevicePixels="True">
            <Grid>
              <!-- Inner gilding stroke. -->
              <Border
                BorderBrush="{DynamicResource Fate.Brush.PanelGild}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Fate.Radius.Lg}"
                IsHitTestVisible="False" />

              <!-- Lit top edge. -->
              <Border
                Height="1"
                Margin="10,0"
                VerticalAlignment="Top"
                Background="{DynamicResource Fate.Brush.PanelHighlight}"
                IsHitTestVisible="False" />

              <ContentPresenter />

              <Rectangle
                Fill="{DynamicResource Fate.Brush.FilmGrain}"
                Opacity="{DynamicResource Fate.Opacity.FilmGrain}"
                Visibility="{DynamicResource Fate.Visibility.FilmGrain}"
                IsHitTestVisible="False" />

              <c:CornerBrackets
                Stroke="{DynamicResource Fate.Brush.BorderEmphasis}"
                StrokeThickness="1"
                ArmLength="14"
                Inset="7"
                Opacity="0.45"
                Visibility="{DynamicResource Fate.Visibility.CornerBrackets}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A quieter card for rows inside a panel. No brackets, no grain. -->
  <Style x:Key="Fate.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Fate.Brush.SurfaceOverlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Fate.Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Fate.Thickness.Stroke}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Fate.Radius.Md}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Fate.Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Fate.Brush.BorderSubtle}" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ==================================================================== buttons -->

  <!--
    One template for every button style. The theme resolves `buttons.style` into these brushes, so
    engraved, foil, glow, ghost, outline and pill all arrive here as data rather than as six
    different templates that have to be kept in step.
  -->
  <Style x:Key="Fate.Button" TargetType="ButtonBase">
    <Setter Property="FontFamily" Value="{DynamicResource Fate.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Body}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.ButtonText}" />
    <Setter Property="Padding" Value="{DynamicResource Fate.Thickness.ButtonPadding}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Grid>
            <!-- RenderTransform is applied by ThemedMotion for the hover lift and press squash. -->
            <Grid.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="PressScale" CenterX="0.5" CenterY="0.5" />
                <TranslateTransform x:Name="HoverLift" />
              </TransformGroup>
            </Grid.RenderTransform>
            <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>

            <Border
              x:Name="Face"
              Background="{DynamicResource Fate.Brush.ButtonFace}"
              BorderBrush="{DynamicResource Fate.Brush.ButtonStroke}"
              BorderThickness="{DynamicResource Fate.Thickness.Stroke}"
              CornerRadius="{DynamicResource Fate.Radius.Button}">
              <Grid>
                <!-- Engraved styles get a lit top edge; every other style publishes it transparent. -->
                <Border
                  Height="1"
                  Margin="6,0"
                  VerticalAlignment="Top"
                  Background="{DynamicResource Fate.Brush.ButtonTopLight}"
                  IsHitTestVisible="False" />

                <ContentPresenter
                  x:Name="Content"
                  Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  RecognizesAccessKey="True"
                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Grid>
            </Border>

            <!-- Focus is drawn separately so it survives whatever the face is doing. -->
            <Border
              x:Name="FocusRing"
              BorderBrush="{DynamicResource Fate.Brush.AccentHover}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Fate.Radius.Button}"
              Margin="-2"
              Opacity="0"
              IsHitTestVisible="False" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Fate.Brush.ButtonFaceHover}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Fate.Brush.ButtonStrokeHover}" />
              <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.ButtonTextHover}" />
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Fate.Brush.ButtonFacePressed}" />
            </Trigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Fate.Brush.ButtonFaceDisabled}" />
              <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.ButtonTextDisabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource Fate.Button}" />

  <!-- The on/off face for an entity. Adds the active state the plain button has no use for. -->
  <Style x:Key="Fate.Toggle" TargetType="ToggleButton" BasedOn="{StaticResource Fate.Button}">
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.ButtonTextActive}" />
      </Trigger>
    </Style.Triggers>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border
              x:Name="Face"
              Background="{DynamicResource Fate.Brush.ButtonFace}"
              BorderBrush="{DynamicResource Fate.Brush.ButtonStroke}"
              BorderThickness="{DynamicResource Fate.Thickness.Stroke}"
              CornerRadius="{DynamicResource Fate.Radius.Button}">
              <Grid>
                <Border
                  Height="1"
                  Margin="6,0"
                  VerticalAlignment="Top"
                  Background="{DynamicResource Fate.Brush.ButtonTopLight}"
                  IsHitTestVisible="False" />

                <ContentPresenter
                  Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Grid>
            </Border>

            <Border
              x:Name="FocusRing"
              BorderBrush="{DynamicResource Fate.Brush.AccentHover}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Fate.Radius.Button}"
              Margin="-2"
              Opacity="0"
              IsHitTestVisible="False" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Fate.Brush.ButtonFaceActive}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Fate.Brush.ButtonStrokeActive}" />
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Fate.Brush.ButtonStrokeHover}" />
            </Trigger>

            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Fate.Brush.ButtonFaceHover}" />
            </MultiTrigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Fate.Brush.ButtonFaceDisabled}" />
              <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.ButtonTextDisabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The primary action.

    Gold outline, gold text, a dark fill, and a halo on hover — the treatment the reference product
    uses for its one important button on a page. Deliberately distinct from the default button,
    because previously every button on a page looked identical and nothing led the eye.
  -->
  <Style x:Key="Fate.Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Fate.Button}">
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Grid>
            <!-- The halo sits outside the face, so it reads as light rather than as a fill. -->
            <Border
              x:Name="Halo"
              Margin="-3"
              CornerRadius="{DynamicResource Fate.Radius.Button}"
              Background="{DynamicResource Fate.Brush.AccentGlow}"
              Opacity="0"
              IsHitTestVisible="False" />

            <Border
              x:Name="Face"
              Background="{DynamicResource Fate.Brush.SurfaceRaised}"
              BorderBrush="{DynamicResource Fate.Brush.AccentDefault}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Fate.Radius.Button}">
              <ContentPresenter
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                RecognizesAccessKey="True"
                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Halo" Property="Opacity" Value="0.35" />
              <Setter TargetName="Face" Property="BorderBrush"
                      Value="{DynamicResource Fate.Brush.AccentHover}" />
              <Setter TargetName="Face" Property="Background"
                      Value="{DynamicResource Fate.Brush.AccentSubtle}" />
              <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.AccentHover}" />
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Halo" Property="Opacity" Value="0" />
              <Setter TargetName="Face" Property="BorderBrush"
                      Value="{DynamicResource Fate.Brush.AccentPressed}" />
              <Setter TargetName="Face" Property="Background"
                      Value="{DynamicResource Fate.Brush.SurfaceSunken}" />
            </Trigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Halo" Property="Opacity" Value="0.5" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="BorderBrush"
                      Value="{DynamicResource Fate.Brush.BorderDefault}" />
              <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextFaint}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Square icon-only button, for title bars and tile affordances. -->
  <Style x:Key="Fate.Button.Icon" TargetType="Button" BasedOn="{StaticResource Fate.Button}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!--
    Title-bar caption buttons. Frameless: a visible box around minimise/maximise/close is the
    fastest way to make custom chrome read as a mock-up rather than a window.
  -->
  <Style x:Key="Fate.Button.Caption" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Face" Background="Transparent">
            <ContentPresenter
              x:Name="Glyph"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              TextElement.Foreground="{DynamicResource Fate.Brush.TextMuted}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Fate.Brush.SurfaceHighest}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Fate.Brush.SurfaceOverlay}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The close button owns its glyph so the hover trigger can recolour it: a Path does not
       inherit TextElement.Foreground, and a muted glyph on the danger fill would be unreadable. -->
  <Style x:Key="Fate.Button.CaptionClose" TargetType="Button" BasedOn="{StaticResource Fate.Button.Caption}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Face" Background="Transparent">
            <Path
              x:Name="Glyph"
              Style="{StaticResource Fate.UiIcon}"
              Data="{StaticResource Fate.Icon.Close}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <!-- Red on hover is the one caption convention every Windows user has learned.
                 The theme's danger colour stands in for the system red so it follows the theme. -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Fate.Brush.StatusDanger}" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Fate.Brush.TextInverse}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Fate.Brush.StatusDanger}" />
              <Setter TargetName="Face" Property="Opacity" Value="0.85" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Fate.Brush.TextInverse}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The pin control beside a browser row: quiet until it matters. Owns its glyph so the
       checked state can gild it. -->
  <Style x:Key="Fate.Toggle.Pin" TargetType="ToggleButton">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border
            x:Name="Face"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="18">
            <Path
              x:Name="Glyph"
              Style="{StaticResource Fate.UiIcon}"
              Data="{StaticResource Fate.Icon.Pin}"
              Width="15"
              Height="15"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Stroke="{DynamicResource Fate.Brush.TextFaint}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Fate.Brush.AccentDefault}" />
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Fate.Brush.AccentSubtle}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Fate.Brush.AccentDefault}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Fate.Brush.SurfaceHighest}" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Fate.Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Fate.Brush.AccentHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A pill segment, for two-way choices like which surface the layout editor is arranging. -->
  <Style x:Key="Fate.SegmentButton" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextMuted}" />
    <Setter Property="FontFamily" Value="{DynamicResource Fate.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Body}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border
            x:Name="Face"
            Padding="14,6"
            Background="Transparent"
            CornerRadius="{DynamicResource Fate.Radius.Pill}">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Fate.Brush.AccentSubtle}" />
              <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextAccent}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextPrimary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================== switch -->

  <!-- A sliding switch, for settings. Reads as a state rather than an action. -->
  <Style x:Key="Fate.Switch" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border
              x:Name="Track"
              Width="40"
              Height="22"
              Background="{DynamicResource Fate.Brush.SurfaceSunken}"
              BorderBrush="{DynamicResource Fate.Brush.BorderDefault}"
              BorderThickness="1"
              CornerRadius="11" />

            <Ellipse
              x:Name="Knob"
              Width="14"
              Height="14"
              Margin="4,0,0,0"
              HorizontalAlignment="Left"
              Fill="{DynamicResource Fate.Brush.TextMuted}" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Fate.Brush.AccentDefault}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Fate.Brush.AccentDefault}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Fate.Brush.TextInverse}" />
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Fate.Brush.AccentHover}" />
            </Trigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Fate.Brush.AccentHover}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================== slider -->

  <Style x:Key="Fate.Slider.Thumb" TargetType="Thumb">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid>
            <Ellipse
              x:Name="Halo"
              Fill="{DynamicResource Fate.Brush.AccentGlow}"
              Margin="-5"
              Opacity="0" />
            <Ellipse
              Fill="{DynamicResource Fate.Brush.AccentDefault}"
              Stroke="{DynamicResource Fate.Brush.SurfaceSunken}"
              StrokeThickness="1.5" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Halo" Property="Opacity" Value="0.7" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Halo" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Fate.Slider" TargetType="Slider">
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="20" VerticalAlignment="Center">
            <Border
              Height="4"
              VerticalAlignment="Center"
              Background="{DynamicResource Fate.Brush.SurfaceSunken}"
              BorderBrush="{DynamicResource Fate.Brush.BorderSubtle}"
              BorderThickness="1"
              CornerRadius="2" />

            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Grid Background="Transparent">
                        <!-- The filled portion. Reads as the current value at a glance. -->
                        <Border
                          Height="4"
                          Margin="0,0,-4,0"
                          VerticalAlignment="Center"
                          Background="{DynamicResource Fate.Brush.AccentDefault}"
                          CornerRadius="2" />
                      </Grid>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>

              <Track.Thumb>
                <Thumb Style="{StaticResource Fate.Slider.Thumb}" />
              </Track.Thumb>

              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================== text input -->

  <Style x:Key="Fate.TextBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource Fate.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Fate.Brush.AccentDefault}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Fate.Brush.AccentDefault}" />
    <Setter Property="SelectionOpacity" Value="0.35" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border
            x:Name="Face"
            Background="{DynamicResource Fate.Brush.SurfaceSunken}"
            BorderBrush="{DynamicResource Fate.Brush.BorderDefault}"
            BorderThickness="{DynamicResource Fate.Thickness.Stroke}"
            CornerRadius="{DynamicResource Fate.Radius.Sm}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Fate.Brush.BorderEmphasis}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Fate.Brush.AccentDefault}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Fate.PasswordBox" TargetType="PasswordBox">
    <Setter Property="FontFamily" Value="{DynamicResource Fate.Font.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Fate.Brush.AccentDefault}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border
            x:Name="Face"
            Background="{DynamicResource Fate.Brush.SurfaceSunken}"
            BorderBrush="{DynamicResource Fate.Brush.BorderDefault}"
            BorderThickness="{DynamicResource Fate.Thickness.Stroke}"
            CornerRadius="{DynamicResource Fate.Radius.Sm}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Fate.Brush.AccentDefault}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================== scrolling -->

  <!-- A slim overlay scrollbar. The default WPF one looks like Windows XP. -->
  <Style x:Key="Fate.ScrollBar" TargetType="ScrollBar">
    <Setter Property="Width" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border
                        x:Name="Bar"
                        Width="4"
                        Margin="3,0"
                        Background="{DynamicResource Fate.Brush.TextFaint}"
                        CornerRadius="2"
                        Opacity="0.5" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bar" Property="Opacity" Value="0.9" />
                          <Setter TargetName="Bar" Property="Width" Value="6" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Fate.Brush.AccentDefault}" />
                          <Setter TargetName="Bar" Property="Opacity" Value="1" />
                          <Setter TargetName="Bar" Property="Width" Value="6" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Fate.ScrollViewer" TargetType="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="PanningMode" Value="VerticalOnly" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid>
            <!--
              Both of these are load-bearing and neither is optional.

              The name: ScrollViewer locates its presenter with GetTemplateChild by this exact
              string. Without it the presenter is never found and scrolling degrades.

              CanContentScroll: the presenter defaults to false regardless of what the ScrollViewer
              is set to, and false means pixel scrolling, and pixel scrolling silently disables
              virtualisation. A thousand-row list then realises every single row — which is exactly
              what happened here, with a VirtualizingStackPanel correctly configured above it.
            -->
            <ScrollContentPresenter
              x:Name="PART_ScrollContentPresenter"
              CanContentScroll="{TemplateBinding CanContentScroll}"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              Margin="{TemplateBinding Padding}" />
            <ScrollBar
              x:Name="PART_VerticalScrollBar"
              HorizontalAlignment="Right"
              Style="{StaticResource Fate.ScrollBar}"
              Orientation="Vertical"
              Maximum="{TemplateBinding ScrollableHeight}"
              ViewportSize="{TemplateBinding ViewportHeight}"
              Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
              Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================== lists -->

  <Style x:Key="Fate.ListBoxItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Fate.ListBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Fate.ListBoxItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Style="{StaticResource Fate.ScrollViewer}" Focusable="False">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    A virtualising list for large collections.

    Three things are load-bearing and all three are easy to lose:
      * CanContentScroll must be True. Pixel scrolling silently disables virtualisation, which is
        the single most common way a WPF list ends up realising ten thousand elements.
      * VirtualizationMode Recycling reuses containers instead of discarding and rebuilding them.
      * The items panel must not be overridden — ListBox already uses a VirtualizingStackPanel,
        and replacing it with a plain StackPanel turns virtualisation off with no warning.
  -->
  <Style x:Key="Fate.ListBox.Virtualised" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />

    <!-- Keeps content clear of the overlay scrollbar, which otherwise covers right-aligned text. -->
    <Setter Property="Padding" Value="0,0,14,0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Fate.ListBoxItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
    <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Item" />
    <Setter Property="VirtualizingPanel.CacheLength" Value="8,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer
            Style="{StaticResource Fate.ScrollViewer}"
            CanContentScroll="True"
            Focusable="False">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================== combo box -->

  <Style x:Key="Fate.ComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Fate.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Body}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border
            x:Name="Face"
            Background="Transparent"
            CornerRadius="{DynamicResource Fate.Radius.Sm}"
            Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Fate.Brush.AccentSubtle}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextAccent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Fate.ComboBox" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource Fate.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextPrimary}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Fate.ComboBoxItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton
              x:Name="Toggle"
              Focusable="False"
              ClickMode="Press"
              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border
                    x:Name="Face"
                    Background="{DynamicResource Fate.Brush.SurfaceSunken}"
                    BorderBrush="{DynamicResource Fate.Brush.BorderDefault}"
                    BorderThickness="{DynamicResource Fate.Thickness.Stroke}"
                    CornerRadius="{DynamicResource Fate.Radius.Sm}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ContentPresenter Grid.Column="0" />
                      <Path
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Data="M 0 0 L 4 4 L 8 0"
                        Stroke="{DynamicResource Fate.Brush.TextMuted}"
                        StrokeThickness="1.4" />
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Fate.Brush.AccentDefault}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter
              Margin="{TemplateBinding Padding}"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              IsHitTestVisible="False"
              Content="{TemplateBinding SelectionBoxItem}"
              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
              TextElement.Foreground="{TemplateBinding Foreground}" />

            <Popup
              x:Name="PART_Popup"
              AllowsTransparency="True"
              Placement="Bottom"
              PopupAnimation="Fade"
              IsOpen="{TemplateBinding IsDropDownOpen}"
              MinWidth="{TemplateBinding ActualWidth}">
              <Border
                Margin="0,4,0,0"
                Padding="4"
                Background="{DynamicResource Fate.Brush.SurfaceOverlay}"
                BorderBrush="{DynamicResource Fate.Brush.BorderDefault}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Fate.Radius.Md}"
                Effect="{DynamicResource Fate.Effect.PanelShadow}">
                <ScrollViewer Style="{StaticResource Fate.ScrollViewer}" MaxHeight="280">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================== check box -->

  <Style x:Key="Fate.CheckBox" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource Fate.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextPrimary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border
              x:Name="Box"
              Width="18"
              Height="18"
              VerticalAlignment="Center"
              Background="{DynamicResource Fate.Brush.SurfaceSunken}"
              BorderBrush="{DynamicResource Fate.Brush.BorderDefault}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Fate.Radius.Sm}">
              <Path
                x:Name="Tick"
                Margin="3"
                Data="M 0 4 L 3.5 7.5 L 10 0"
                Stretch="Uniform"
                Stroke="{DynamicResource Fate.Brush.TextInverse}"
                StrokeThickness="2"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                Opacity="0" />
            </Border>
            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Fate.Brush.AccentDefault}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fate.Brush.AccentDefault}" />
              <Setter TargetName="Tick" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fate.Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================== expander -->

  <!-- Used for the help topics: a question you can open, not a tree node. -->
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextPrimary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <Border
            x:Name="Face"
            Background="{DynamicResource Fate.Brush.SurfaceSunken}"
            BorderBrush="{DynamicResource Fate.Brush.BorderSubtle}"
            BorderThickness="{DynamicResource Fate.Thickness.Stroke}"
            CornerRadius="{DynamicResource Fate.Radius.Sm}">
            <StackPanel>
              <ToggleButton
                x:Name="Header"
                Cursor="Hand"
                Focusable="True"
                IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="14,11">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />

                        <Path
                          x:Name="Chevron"
                          Grid.Column="1"
                          Style="{StaticResource Fate.UiIcon}"
                          Data="{StaticResource Fate.Icon.ChevronDown}"
                          Width="13"
                          Height="13"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Chevron" Property="Data"
                                Value="{StaticResource Fate.Icon.ChevronUp}" />
                        <Setter TargetName="Chevron" Property="Stroke"
                                Value="{DynamicResource Fate.Brush.AccentDefault}" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chevron" Property="Stroke"
                                Value="{DynamicResource Fate.Brush.TextPrimary}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <ContentPresenter ContentSource="Header" />
              </ToggleButton>

              <ContentPresenter
                x:Name="Body"
                Margin="14,0,14,12"
                Visibility="Collapsed" />
            </StackPanel>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible" />
              <Setter TargetName="Face" Property="BorderBrush"
                      Value="{DynamicResource Fate.Brush.BorderDefault}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================== tooltip -->

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Fate.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Fate.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource Fate.Size.Caption}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border
            Padding="9,6"
            Background="{DynamicResource Fate.Brush.SurfaceHighest}"
            BorderBrush="{DynamicResource Fate.Brush.BorderDefault}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Fate.Radius.Sm}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
