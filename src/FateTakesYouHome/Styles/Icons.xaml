  </Geometry>

  <Geometry x:Key="Fate.Icon.Maximise">
    M5.5,5.5 L18.5,5.5 L18.5,18.5 L5.5,18.5 Z
  </Geometry>

  <Geometry x:Key="Fate.Icon.Search">
