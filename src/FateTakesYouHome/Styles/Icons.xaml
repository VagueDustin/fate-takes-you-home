<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Interface glyphs, on the same 24-unit grid as the entity icons so the two never look like they
    came from different sets. All stroked outlines — see EntityGlyphs for why.
  -->

  <Style x:Key="Fate.UiIcon" TargetType="Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="Stroke" Value="{DynamicResource Fate.Brush.TextMuted}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Three tracks with offset knobs: "tune", which reads better at 16px than a cog. -->
  <Geometry x:Key="Fate.Icon.Settings">
    M4,7 L20,7 M4,12 L20,12 M4,17 L20,17
    M9,5 A2,2 0 1 1 8.99,5 Z
    M15,10 A2,2 0 1 1 14.99,10 Z
    M7,15 A2,2 0 1 1 6.99,15 Z
  </Geometry>

  <Geometry x:Key="Fate.Icon.Expand">
    M14,4 L20,4 L20,10 M20,4 L13.2,10.8
    M10,20 L4,20 L4,14 M4,20 L10.8,13.2
  </Geometry>

  <Geometry x:Key="Fate.Icon.Collapse">
    M20,4 L14,10 M14,4 L14,10 L20,10
    M4,20 L10,14 M10,20 L10,14 L4,14
  </Geometry>

  <Geometry x:Key="Fate.Icon.Pin">
    M12,3 L12,10 M8.5,10 L15.5,10 L14,14.5 L10,14.5 Z M12,14.5 L12,21
  </Geometry>

  <Geometry x:Key="Fate.Icon.Refresh">
    M4.6,12 A7.4,7.4 0 1 1 7.9,18.1 M4.6,12 L4.6,7.6 M4.6,12 L9,12
  </Geometry>

  <Geometry x:Key="Fate.Icon.Close">
