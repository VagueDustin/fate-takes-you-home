<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Interface glyphs, on the same 24-unit grid as the entity icons so the two never look like they
    came from different sets. All stroked outlines; see EntityGlyphs for why.
  -->

  <Style x:Key="Fate.UiIcon" TargetType="Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="Stroke" Value="{DynamicResource Fate.Brush.TextMuted}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!--
    The navigation rail's set. Each starts with "M0,0 M24,24": two bare points that draw nothing
    but fix the bounds to the whole grid, so Stretch="Uniform" scales every glyph by the same
    amount instead of blowing each one up to fill the box. They are drawn as single strokes with
    long, continuous figures because GlyphMotion draws them in when their page is chosen.
  -->

  <!-- The brand's arch with the guiding star in its doorway. -->
  <Geometry x:Key="Fate.Icon.Nav.Home">
    M0,0 M24,24
    M5,20.5 L5,11 A7,7 0 0 1 19,11 L19,20.5 M3,20.5 L21,20.5
    M12,9.6 Q12.35,13.1 14.6,13.8 Q12.35,14.5 12,18 Q11.65,14.5 9.4,13.8 Q11.65,13.1 12,9.6 Z
  </Geometry>

  <Geometry x:Key="Fate.Icon.Nav.Everything">
    M0,0 M24,24
    M10.5,3.8 A6.7,6.7 0 1 1 10.49,3.8 Z M15.4,15.4 L20.5,20.5
    M7.6,10.5 L13.4,10.5 M10.5,7.6 L10.5,13.4
  </Geometry>

  <!-- Four unequal tiles, masonry-fashion: widgets being arranged. -->
  <Geometry x:Key="Fate.Icon.Nav.Layout">
    M0,0 M24,24
    M3.5,3.5 L10.5,3.5 L10.5,12.5 L3.5,12.5 Z
    M13.5,3.5 L20.5,3.5 L20.5,8.5 L13.5,8.5 Z
    M13.5,11.5 L20.5,11.5 L20.5,20.5 L13.5,20.5 Z
    M3.5,15.5 L10.5,15.5 L10.5,20.5 L3.5,20.5 Z
  </Geometry>

  <Geometry x:Key="Fate.Icon.Nav.Themes">
    M0,0 M24,24
    M12,3.4 A8.6,8.6 0 0 0 12,20.6 C13.6,20.6 14.4,19.6 14.4,18.4
    C14.4,17.2 13.4,16.4 13.4,15.4 C13.4,14.4 14.2,13.8 15.2,13.8
    L17,13.8 A3.6,3.6 0 0 0 20.6,10.2 C20.6,6.4 16.8,3.4 12,3.4 Z
    M7.6,11.2 L7.61,11.2 M9.8,7.6 L9.81,7.6 M14.2,7.6 L14.21,7.6
  </Geometry>

  <!-- A key cap with a spark: one key, and something happens. -->
