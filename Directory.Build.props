<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;NU1701</NoWarn>

    <!-- Permits a restore of these net8.0-windows projects on a non-Windows host. Nothing here is
         buildable off Windows and nothing tries to be; what needs it is GitHub's dependency
         submission, which restores on Linux to record the full transitive package graph that
         Dependabot's security alerts are computed from. Without this the restore stops at
         NETSDK1100 and the graph is whatever could be read off the manifests, which is to say
         direct references only. On Windows the guard never fires and the property is unread. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Product identity. Single source of truth for versioning and branding strings. -->
  <PropertyGroup>
    <Product>Fate Takes You Home</Product>
    <Company>VagueDustin Enterprises</Company>
    <Authors>VagueDustin Enterprises</Authors>
    <Copyright>Copyright © 2026 VagueDustin Enterprises</Copyright>
    <VersionPrefix>0.3.1</VersionPrefix>
    <RepositoryUrl>https://github.com/VagueDustin/fate-takes-you-home</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Note: the WindowsDesktop SDK deliberately removes System.IO from the implicit usings for
       WPF projects, because System.IO.Path collides with System.Windows.Shapes.Path. Do not add
       it back globally — WPF files declare "using System.IO;" individually where they need it. -->

</Project>
