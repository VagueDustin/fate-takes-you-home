# Normalise to LF in the repository; Git checks out CRLF on Windows via core.autocrlf.
* text=auto

# Windows tooling that is unhappy with LF regardless of platform.
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf
*.sln     text eol=crlf

# Source and data.
*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.props   text
*.targets text
*.wxs     text
*.json    text
*.md      text
*.yml     text

# Binary. Never normalise, never diff as text.
*.png     binary
*.jpg     binary
*.webp    binary
*.ico     binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.msi     binary
*.zip     binary
*.pfx     binary

# Generated assets: real files, but not worth reading in a diff.
src/FateTakesYouHome/Assets/Icons/** linguist-generated=true
docs/images/**                       linguist-generated=true
